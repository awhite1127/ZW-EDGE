[Unit]
Description=Edge Controller Backend
Wants=network.target
After=network.target edge-upgrade-recovery.service

[Service]
Type=simple
User=root
Group=edge-controller
WorkingDirectory=/opt/edge-controller
EnvironmentFile=/opt/edge-controller/config/edge-controller.env
Environment=EDGE_IPC_SOCKET_GROUP=edge-controller
ExecCondition=+/usr/bin/python3 /opt/edge-controller/update/recovery/update-manager.py service-start-allowed
ExecStartPre=/usr/bin/install -d -o root -g edge-controller -m 0770 ${EDGE_CONTROLLER_RUN_DIR}
ExecStartPre=/usr/bin/chmod u-s,g-s,o-t ${EDGE_CONTROLLER_RUN_DIR}
ExecStartPre=/usr/bin/chmod 0770 ${EDGE_CONTROLLER_RUN_DIR}
ExecStartPre=-/usr/bin/rm -f ${EDGE_CONTROLLER_IPC_SOCK}
ExecStartPre=-/usr/bin/find ${EDGE_CONTROLLER_RUN_DIR} -maxdepth 1 -type f -name *.pid -delete
ExecStart=/opt/edge-controller/bin/edge-controller
ExecStopPost=-/usr/bin/rm -f ${EDGE_CONTROLLER_IPC_SOCK}
Restart=on-failure
RestartSec=3
UMask=0007
StandardOutput=append:/opt/edge-controller/log/edge-controller.log
StandardError=append:/opt/edge-controller/log/edge-controller.log

[Install]
WantedBy=multi-user.target
