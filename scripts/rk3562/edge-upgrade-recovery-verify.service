[Unit]
Description=Edge Controller Recovered Application Health Confirmation
Wants=edge-controller.service edge-web.service edge-log-rotator.service
After=edge-upgrade-recovery.service edge-controller.service edge-web.service edge-log-rotator.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/edge-controller/update
ExecStart=/usr/bin/python3 /opt/edge-controller/update/recovery/update-manager.py recover-finalize
TimeoutStartSec=3min
UMask=0077
StandardOutput=append:/opt/edge-controller/log/update.log
StandardError=append:/opt/edge-controller/log/update.log

[Install]
WantedBy=multi-user.target
